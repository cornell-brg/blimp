#-------------------------------------------------------------------------
# print_eval
#-------------------------------------------------------------------------

def print_eval( name ):

  eval_saif_file    = f"../07-synopsys-vcs-baglsim/{name}.saif"
  eval_power_report = f"../08-synopsys-pt-pwr/{name}-summary.rpt"

  print("")
  print(f" {name}")

  if not Path(eval_saif_file).exists():
    print(f" - {RED}{eval_saif_file} not found{RESET}" )
    return

  if not Path(eval_power_report).exists():
    print(f" - {RED}{eval_power_report} not found{RESET}" )
    return

  exec_time_ns     = 0.0
  exec_time_cycles = 0.0
  with open( eval_saif_file, "r" ) as file:
    for line in file:
      if line.startswith("(DURATION "):
        exec_time_ps     = float(line.split()[1].strip(')'))
        exec_time_ns     = exec_time_ps/1000.0
        exec_time_cycles = int(exec_time_ns/{{clock_period}})

  power_mw  = 0.0
  energy_nj = 0.0
  with open( eval_power_report, "r" ) as file:
    for line in file:
      if line.startswith("Total Power"):
        power_watts     = float(line.split()[3].strip())
        power_mw        = power_watts*1000.0
        energy_nj       = power_watts*exec_time_ns

  print(f"  - exec_time = {exec_time_cycles} cycles")
  print(f"  - exec_time = {exec_time_ns:0.4f} ns")
  print(f"  - power     = {power_mw:0.4f} mW")
  print(f"  - energy    = {energy_nj:0.4f} nJ")

#-------------------------------------------------------------------------
# print_log_errors
#-------------------------------------------------------------------------

def print_log_errors( log_dir, label, log_file_name=None ):

  log_dir_path = Path(log_dir)
  if not log_dir_path.exists():
    print(f" {label:<{W}} = {RED}{log_dir} not found{RESET}")
    failures.append(f"{label}: {log_dir} not found")
    return

  if log_file_name:
    log_files = [log_dir_path / log_file_name]
    if not log_files[0].exists():
      print(f" {label:<{W}} = {RED}{log_files[0]} not found{RESET}")
      failures.append(f"{label}: {log_files[0]} not found")
      return
  else:
    log_files = sorted(log_dir_path.glob("*.log"))
    if not log_files:
      print(f" {label:<{W}} = {RED}no log files found in {log_dir}{RESET}")
      failures.append(f"{label}: no log files found in {log_dir}")
      return

  for log_file in log_files:
    error_count = 0
    with open( log_file, "r" ) as file:
      for line in file:
        if re.search( r"error", line, re.IGNORECASE ):
          # Skip lines that report "0 error" (but not "10 error", "20 error", etc.)
          if re.search( r"(?<!\d)0\s+error", line, re.IGNORECASE ):
            continue
          error_count += 1

    log_name = f"{log_file.stem} ({label})"
    if error_count > 0:
      print(f" {log_name:<{W}} = {RED}{error_count} error(s) found{RESET}")
      failures.append(f"{label}: {log_file.stem} has {error_count} error(s)")
    else:
      print(f" {log_name:<{W}} = no errors")

#-------------------------------------------------------------------------
# print_drc
#-------------------------------------------------------------------------

def print_drc( drc_reports ):

  for drc_report in drc_reports:
    label = Path(drc_report).parent.name

    if not Path(drc_report).exists():
      print(f" {label:<{W}} = {RED}{drc_report} not found{RESET}")
      failures.append(f"drc: {drc_report} not found")
      continue

    in_section = False
    found = False
    with open( drc_report, "r" ) as file:
      for line in file:
        if "RULECHECK RESULTS STATISTICS (BY CELL)" in line:
          next(file)  # skip "---" line
          in_section = True
          continue
        if in_section:
          if "------------" in line:
            break
          if line.startswith("CELL"):
            total = line.split("TOTAL Result Count = ")[1].split()[0]
            if int(total) > 0:
              print(f" {label:<{W}} = {RED}{total} DRC violations{RESET}")
              failures.append(f"drc: {drc_report} has {total} violations")
            else:
              print(f" {label:<{W}} = {total} DRC violations")
            found = True
          elif "RULECHECK" in line:
            rule  = line.split("RULECHECK")[1].split()[0]
            parts = line.split()
            count = parts[-2]
            print(f"  - {rule:<{W}} = {count}")

    if not found:
      print(f" {label:<{W}} = no violations found")

#-------------------------------------------------------------------------
# print_lvs
#-------------------------------------------------------------------------

def print_lvs( lvs_report, lvs_log ):

  label = "lvs"
  if not Path(lvs_report).exists():
    print(f" {label:<{W}} = {RED}{lvs_report} not found{RESET}")
    failures.append(f"lvs: {lvs_report} not found")
    return

  if not Path(lvs_log).exists():
    print(f" {label:<{W}} = {RED}{lvs_log} not found{RESET}")
    failures.append(f"lvs: {lvs_log} not found")
    return

  # Check if log file contains "LVS completed."

  with open( lvs_log, "r" ) as file:
    log_content = file.read()

  lvs_completed = "LVS completed." in log_content

  with open( lvs_report, "r" ) as file:
    lines = file.readlines()

  design_name = "{{ design_name }}"

  # Find the CELL SUMMARY section and check the result for the wrapper cell

  in_cell_summary = False
  for line in lines:
    if "CELL  SUMMARY" in line:
      in_cell_summary = True
      continue
    if in_cell_summary:
      if design_name in line:
        if line.strip().startswith("CORRECT") and lvs_completed:
          print(f" {label:<{W}} = no violations found")
        else:
          if not lvs_completed:
            print(f" {label:<{W}} = {RED}FAILED: LVS did not complete{RESET}")
            failures.append(f"lvs: LVS did not complete")
          else:
            print(f" {label:<{W}} = {RED}FAILED{RESET}")
            failures.append(f"lvs: layout vs. schematic check failed")
        return

  print(f" {label:<{W}} = {RED}FAILED: {design_name} not found in CELL SUMMARY{RESET}")
  failures.append(f"lvs: {design_name} not found in CELL SUMMARY")

#-------------------------------------------------------------------------
# main
#-------------------------------------------------------------------------

def main():

  # Print Header
  print("")
  print(f" {'timestamp':<{W}} = {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
  print(f" {'design_name':<{W}} = {{design_name}}")
  print(f" {'clock_period':<{W}} = {{clock_period}}")

  # Resolved Top-Level Parameters
  print_resolved_params("../01-verilator-pickle/run.log")

  print("")

  # PyMTL RTL Simulation
  print_sim("../01-verilator-pickle/run.log","verilator-pickle")
  print_verilator_pickle_errors("../01-verilator-pickle/run.log")

  # Four-State RTL Simulation
  print_sim("../02-synopsys-vcs-rtlsim/run.log","vcs-rtlsim")

  # Synthesis Summary
  print_synth_slack("../03-synopsys-dc-synth/timing.rpt")
  print_synth_area("../03-synopsys-dc-synth/area.rpt")
  print_log_errors("../03-synopsys-dc-synth","synthesis","run.log")

  # Fast-Functional Gate-Level Simulation
  print_sim("../04-synopsys-vcs-ffglsim/run.log","ffglsim")

  # Place-and-Route Summary
  print_pnr_slack("../05-cadence-innovus-pnr/timing-setup.rpt","setup_slack")
  print_pnr_slack("../05-cadence-innovus-pnr/timing-hold.rpt","hold_slack")
  print_pnr_clk_ins_src_lat("../05-cadence-innovus-pnr/post-pnr.sdc")
  print_pnr_area("../05-cadence-innovus-pnr/area.rpt")
  print_log_errors("../05-cadence-innovus-pnr","pnr","run.log")

  # Static Timing Analysis Summary
  print_sta_slack("../06-synopsys-pt-sta/timing-setup.rpt","setup_slack")
  print_sta_slack("../06-synopsys-pt-sta/timing-hold.rpt","hold_slack")

  # Back-Annotated Gate-Level Simulation
  print_sim("../07-synopsys-vcs-baglsim/run.log","baglsim")

  # Design Rules Check
  print_drc([
    "../09-mentor-calibre-drc/main-drc/run.summary",
    "../09-mentor-calibre-drc/antenna-drc/run.summary"
  ])

  # Layout vs. Schematic Check
  print_lvs("../10-mentor-calibre-lvs/lvs.report", "../10-mentor-calibre-lvs/run.log")

  # Print each evaluation sim and power results
  {% for item in evals | default([]) -%}
  {% if item is mapping -%}
  {% for sim_name, config in item.items() -%}
  print_eval("{{ sim_name }}-{{ config.elf | replace("/", "-") }}")
  {% endfor -%}
  {% endif -%}
  {% endfor %}

  # Print Summary

  print("")
  if len(failures) == 0:
    print(" \033[32mAll checks passed\033[0m")
  else:
    print(f" \033[31m{len(failures)} check(s) failed:\033[0m")
    for failure in failures:
      print(f"  - {failure}")

  print("")

if __name__ == "__main__":
  main()


