#-------------------------------------------------------------------------
# print_synth_area
#-------------------------------------------------------------------------

def print_synth_area( synth_area_report ):

  label_cells = "synth_num_stdcells"
  label_area  = "synth_area"
  if not Path(synth_area_report).exists():
    print(f" {label_cells:<{W}} = {RED}{synth_area_report} not found{RESET}" )
