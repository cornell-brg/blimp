        fields = line.split(":")
        print(f" {label_area:<{W}} = {float(fields[1]):0.3f} um^2" )

#-------------------------------------------------------------------------
# print_slack
#-------------------------------------------------------------------------

def print_pnr_slack( pnr_timing_setup_report, name ):

  label = f"pnr_{name}"
  if not Path(pnr_timing_setup_report).exists():
    print(f" {label:<{W}} = {RED}{pnr_timing_setup_report} not found{RESET}" )
    failures.append(f"{label}: {pnr_timing_setup_report} not found")
    return

  slack = ""
  with open( pnr_timing_setup_report, "r" ) as file:
    for line in file:
      if line[2:12] == "Slack Time":
        fields = line.split("Time")
        slack = fields[1].strip()
        break

  if slack != "":
    check_str = ""
    if float(slack) < 0:
      check_str = f"{RED}(must have positive slack!){RESET}"
      failures.append(f"{label}: negative slack ({slack} ns)")
    print(f" {label:<{W}} = {slack} ns {check_str}")
  else:
    print(f" {label:<{W}} = no hold-constrained paths found")

#-------------------------------------------------------------------------
# print_pnr_area
#-------------------------------------------------------------------------

def print_pnr_area( pnr_area_report ):

  label_density   = "pnr_density"
  label_cells     = "pnr_num_stdcells"
  label_cell_area = "pnr_cell_area"
  label_core_area = "pnr_core_area"

  if not Path(pnr_area_report).exists():
    print(f" {label_density:<{W}} = {RED}{pnr_area_report} not found{RESET}" )
    print(f" {label_cells:<{W}} = {RED}{pnr_area_report} not found{RESET}" )
    print(f" {label_cell_area:<{W}} = {RED}{pnr_area_report} not found{RESET}" )
    print(f" {label_core_area:<{W}} = {RED}{pnr_area_report} not found{RESET}" )
    failures.append(f"pnr_area: {pnr_area_report} not found")
    return

  density = None
  num_stdcells = None
  cell_area = None
  core_area = None

  in_pre_filler = False
  in_post_filler = False
  found_pre_header = False
  found_post_header = False

  with open( pnr_area_report, "r" ) as file:
    for line in file:
      # Track which section we're in
      if "Area pre-filler" in line:
        in_pre_filler = True
        in_post_filler = False
        continue
      if "Area post-filler" in line:
        in_pre_filler = False
        in_post_filler = True
        continue

      # Extract placement density from pre-filler section (not including fixed std cells)
      if in_pre_filler and line.strip().startswith("Placement Density:") and "including fixed" not in line:
        match = re.search(r'Placement Density:(\d+\.\d+)%', line)
        if match:
          density = match.group(1)

      # Look for header line to find data rows
      if "Hinst Name" in line and "Module Name" in line:
        if in_pre_filler:
          found_pre_header = True
        elif in_post_filler:
          found_post_header = True
        continue

      # Skip the dashed separator line
      if line.startswith("----"):
        continue

      # Extract pre-filler stats (first data row after header)
      if in_pre_filler and found_pre_header and num_stdcells is None:
        fields = line.split()
        if len(fields) >= 3:
          num_stdcells = fields[-2]
          cell_area = fields[-1]

      # Extract post-filler stats (first data row after header)
      if in_post_filler and found_post_header and core_area is None:
        fields = line.split()
        if len(fields) >= 3:
          core_area = fields[-1]

  if density:
    print(f" {label_density:<{W}} = {density}%")
  else:
    print(f" {label_density:<{W}} = {RED}not found{RESET}")

  if num_stdcells:
    print(f" {label_cells:<{W}} = {num_stdcells}")
  else:
    print(f" {label_cells:<{W}} = {RED}not found{RESET}")

  if cell_area:
    print(f" {label_cell_area:<{W}} = {cell_area} um^2")
  else:
    print(f" {label_cell_area:<{W}} = {RED}not found{RESET}")

  if core_area:
    print(f" {label_core_area:<{W}} = {core_area} um^2")
  else:
    print(f" {label_core_area:<{W}} = {RED}not found{RESET}")

#-------------------------------------------------------------------------
# print_pnr_clk_ins_src_lat
#-------------------------------------------------------------------------

def print_pnr_clk_ins_src_lat( pnr_sdc_file ):

  label = "pnr_clk_ins_src_lat"
  if not Path(pnr_sdc_file).exists():
    print(f" {label:<{W}} = {RED}{pnr_sdc_file} not found{RESET}" )
    return

  clk_ins_src_lat = 0;
  with open( pnr_sdc_file, "r" ) as file:
    for line in file:
      if line.startswith("set_clock_lat"):
        lat = float(line.split()[5].strip())
        if lat < clk_ins_src_lat:
          clk_ins_src_lat = lat

  print(f" {label:<{W}} = {clk_ins_src_lat} ns")

