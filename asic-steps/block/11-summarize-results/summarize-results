#!/usr/bin/env python
#=========================================================================
# summarize-results
#=========================================================================
# Parse reports from various EDA tools to summarize as follows:
#
#  - Timestamp
#  - Design name
#  - Clock period in ns
#  - Four-state RTL simulation results
#  - Synthesis setup slack in ns
#  - Synthesis num stdcells
#  - Synthesis area in um^2
#  - Fast-functional gate-level simulation results
#  - Place-and-route setup slack in ns
#  - Place-and-route hold slack in ns
#  - Place-and-route clock insertion source latency in ns
#  - Place-and-route num stdcells
#  - Place-and-route area in um^2
#  - Back-annotated gate-level simulation results
#  - For each evaluation
#     + Execution time in cycles
#     + Execution time in ns
#     + Power in mW
#     + Energy in nJ
#
# Author : Christopher Batten & Parker Schless
# Date   : April 2025
#

import re
from datetime import datetime
from pathlib import Path

RED   = "\033[31m"
GREEN = "\033[32m"
RESET = "\033[0m"

W = 24  # label column width (chars before '=')

failures = []

#-------------------------------------------------------------------------
# print_resolved_params
#-------------------------------------------------------------------------

def print_resolved_params( run_log ):

  label = "resolved_params"
  if not Path(run_log).exists():
    print(f" {label:<{W}} = {RED}{run_log} not found{RESET}")
    return

  in_params = False
  with open( run_log, "r" ) as file:
    for line in file:
      if "Resolved top-level parameters:" in line:
        in_params = True
        print("")
        print(f" {label}")
        continue
      if in_params:
        if line.startswith("---"):
          continue
        stripped = line.strip()
        if stripped == "":
          break
        # Parse "parameter <name> = <value>,"
        match = re.match(r'parameter\s+(\S+)\s*=\s*(.+?),?\s*$', stripped)
        if match:
          name  = match.group(1)
          value = match.group(2).strip()
          print(f"  - {name:<{W}} = {value}")

#-------------------------------------------------------------------------
# print_sim
#-------------------------------------------------------------------------

def print_sim( sim_log, name ):

  if not Path(sim_log).exists():
    print(f" {name:<{W}} = {RED}{sim_log} not found{RESET}")
    failures.append(f"{name}: {sim_log} not found")
    return

  num_passed = 0
  num_failed = 0
  with open( sim_log, "r" ) as file:
    for line in file:
      if "passed" in line:
        num_passed += 1
      elif "FAILED" in line:
        num_failed += 1

  check_str = ""
  if num_failed > 0:
    check_str = f"{RED}(all tests must pass!){RESET}"
    failures.append(f"{name}: {num_failed} test(s) failed")

  print(f" {name:<{W}} = {num_passed}/{num_passed+num_failed} passed {check_str}")

#-------------------------------------------------------------------------
# print_verilator_pickle_errors
#-------------------------------------------------------------------------

def print_verilator_pickle_errors( run_log ):

  label = "verilator-pickle-errors"
  if not Path(run_log).exists():
    print(f" {label:<{W}} = {RED}{run_log} not found{RESET}")
    failures.append(f"{label}: {run_log} not found")
    return

  with open( run_log, "r" ) as file:
    content = file.read()

  if "ERROR" in content or 'error' in content or 'Error' in content:
    print(f" {label:<{W}} = {RED}ERROR found in {run_log}{RESET}")
    failures.append(f"{label}: ERROR found in {run_log}")
  else:
    print(f" {label:<{W}} = no errors")

#-------------------------------------------------------------------------
# print_synth_slack
#-------------------------------------------------------------------------

def print_synth_slack( synth_slack_report ):

  label = "synth_setup_slack"
  if not Path(synth_slack_report).exists():
    print(f" {label:<{W}} = {RED}{synth_slack_report} not found{RESET}" )
